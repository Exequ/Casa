{
  "name": "casa-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Herramienta web local para diseñar y decorar una casa en 3D",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "comprobar": "tsc --noEmit",
    "catalogo:ejemplos": "node scripts/generar-catalogo.mjs",
    "vivienda:generar": "node scripts/digitalizar-plano.mjs",
    "catalogo:lote1": "node scripts/catalogo-lote1.mjs",
    "catalogo:miniaturas": "node scripts/miniaturas.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
